[Unit]
Description=NetShield-IoT Wireless Network Optimization & DNS Guard Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change to your non-root username
User=%I
WorkingDirectory=/home/octopaul/antigravity/NetShield-IoT
ExecStart=/usr/bin/python3 /home/octopaul/antigravity/NetShield-IoT/laptop_engine/netshield.py

# Grants Port 53 binding permission to standard non-root user without sudo
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
